# ─── xprinter.uz production template ──────────────────────────────
# Copy to .env on the server and fill every value. Never commit the real .env.

APP_NAME="Xprinter.uz"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://xprinter.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=uz_UZ

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ─── Database (MySQL 8) ───────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xprinter
DB_USERNAME=xprinter
DB_PASSWORD=

# ─── Sessions / cache / queue ─────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=xprinter.uz

CACHE_STORE=database
QUEUE_CONNECTION=database        # run: php artisan queue:work --tries=3 (supervisor)

FILESYSTEM_DISK=public

# ─── Mail (transactional: approvals, leads, backup alerts) ────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=noreply@xprinter.uz
MAIL_FROM_NAME="Xprinter.uz"

# ─── Telegram bot ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Backups → S3-compatible bucket (not the app server!) ─────────
BACKUP_DISK_DRIVER=s3
BACKUP_NOTIFY_EMAIL=info@xprinter.uz
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=xprinter-backups
BACKUP_S3_ENDPOINT=              # e.g. https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_REGION=auto
BACKUP_S3_ROOT=xprinter

# ─── Error tracking (optional, pick one) ──────────────────────────
# SENTRY_LARAVEL_DSN=
# FLARE_KEY=

# ─── Cron (crontab -e on the server) ──────────────────────────────
# * * * * * cd /var/www/xprinter && php artisan schedule:run >> /dev/null 2>&1
